/bin/
/data/
/_site/
# Both, and not just the one that was expected. Running vitest from the repo
# root rather than from web/frontend puts its cache in a node_modules/ HERE,
# which this file did not cover — so node_modules/.vite/vitest/…/results.json
# was committed once and then reported itself modified after every test run,
# forever. A path-anchored ignore only covers the path somebody thought of.
node_modules/
web/frontend/node_modules/
*.tar.gz
.vscode/
.claude/

# Real personal exports used as local test fixtures (privacy: they contain
# reading history / account details). Tests skip when these are absent;
# committed synthetic fixtures cover the same formats in CI.
internal/importer/testdata/*_real.*
# Raw personal exports dropped here before being installed as _real fixtures
# (see internal/importer/testdata). Same privacy reason as the line above; this
# directory is the staging area, testdata/ is what the tests read.
/input_samples/
# A _real fixture that is a directory of exports, not a single file — the glob
# above needs the dot, so it does not cover bookcision_real/.
internal/importer/testdata/*_real/
